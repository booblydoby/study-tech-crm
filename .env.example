# Database (PostgreSQL)
DATABASE_URL="postgresql://study:study@localhost:5432/study_crm?schema=public"

# API server
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
NODE_ENV=development
SWAGGER_ENABLED=true

# JWT (change these secrets before real use!)
JWT_ACCESS_SECRET="change-me-access-secret-min-24-chars"
JWT_ACCESS_TTL="1h"
JWT_REFRESH_TTL_DAYS=30

# First admin account (used by db:seed)
ADMIN_EMAIL="admin@study.local"
ADMIN_PASSWORD="ChangeMe123!"

# Demo accounts for teacher/student (used by db:seed)
DEMO_TEACHER_PASSWORD="TeacherDemo123!"
DEMO_STUDENT_PASSWORD="StudentDemo123!"

# Web app (must point to API)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
WEB_PORT=3000
