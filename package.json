{
  "name": "study-center-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @study-crm/api --filter @study-crm/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,prisma}\"",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate:deploy && pnpm db:seed",
    "db:generate": "pnpm --filter @study-crm/api prisma:generate",
    "db:migrate": "pnpm --filter @study-crm/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @study-crm/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @study-crm/api prisma:seed",
    "db:reset": "pnpm --filter @study-crm/api prisma:reset"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
